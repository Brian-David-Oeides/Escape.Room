  m_Script: {fileID: 11500000, guid: 5e024f7a239629a49ac6b36057a7237d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  pages:
  - pageImage: {fileID: 0}
    pageText: 'Been complaining about the lighting in here for months. The breaker
      panel is temperamental. Lights will trip if it gets too humid in here. Finally
      got those new LED panels installed today, but of course the wiring in this
      ancient building made it complicated. '
    pageTitle: 
  - pageImage: {fileID: 0}
    pageText: 'Had to rewire the entire circuit and add a separate switch panel.

      IMPORTANT:
      To activate all lights, you need to find them beneath the cabinet to the left
      of the double doors.


      PS. When you get the lights back on, please return
      the 3  pictures and tools back in their proper place. Thanks, Dave.

'
    pageTitle: 
  pageImageComponent: {fileID: 1166677942}
  pageTextComponent: {fileID: 256320455}
