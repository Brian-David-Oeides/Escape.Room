  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "PERSONAL REMINDER Date: 7/16/24 \nFrom: Jim Hargrove\n\nDad's old pocket
    watch finally gave out yesterday. Stopped dead at 3:27 while I was replacing
    that valve gasket. Tried winding it but no luck - probably needs professional
    repair. Sentimental value only, but still hurts - that watch has been ticking
    since before I was born.\nLeft it in my toolbox for now. Will take it to that
    repair shop on Main Street when I get paid."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 6863a22c919b89343954698bfd03b298, type: 2}
