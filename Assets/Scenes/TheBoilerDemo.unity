--- !u!114 &1836905038809101547
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 8091745873640077907}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5e024f7a239629a49ac6b36057a7237d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  pages:
  - pageImage: {fileID: 0}
    pageText: "MAINTENANCE REQUEST FOLLOW-UP \nDate: 2/28/24 \nTech: Ray Simmons\n\nFinally
      got around to checking that supply cabinet in the north corner. Lock is completely
      seized up.\n- rust and who knows what else. Waste of time calling a locksmith
      for something this old."
    pageTitle: 
  - pageImage: {fileID: 0}
    pageText: 'Tried WD-40 but no luck. Was going to force it open with my chisel
      and hammer (usually works for these old jammed cabinets), but got called away
      for that emergency in Building C. Left my chisel somewhere near the electrical
      panel during the chaos. '
    pageTitle: 
  - pageImage: {fileID: 0}
    pageText: "Probably on that shelf underneath. Remind myself to grab it tomorrow.\n\nSupply
      order status:\r\n\r- Replacement gaskets - RECIEVED\r\n\r- Pipe insulation
      - RECIEVED\r\n\r- New cabinet lock (to replace the one I'll have to break)
      - BACKORDERED"
    pageTitle: 
  - pageImage: {fileID: 0}
    pageText: "Note to self: Don't forget to mention the cabinet situation at next
      week's meeting. We need whatever supplies are locked in there for the upcoming
      maintenance schedule.\n\n\tRay"
    pageTitle: 
  pageImageComponent: {fileID: 9067855267050944909}
  pageTextComponent: {fileID: 4333950568749575144}
  pageTitleComponent: {fileID: 351679844699166530}
  pageCounterComponent: {fileID: 7097102974470290508}
  navigationHelpUI: {fileID: 6850407413449194154}
  leftArrowText: {fileID: 7730304394445974989}
  rightArrowText: {fileID: 8374978108600901217}
  slideDistance: 200
  slideSpeed: 8
